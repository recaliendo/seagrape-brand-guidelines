# Copy to .env for local development, and add the same values in Netlify:
# Site configuration → Environment variables. Never commit real values.

# --- Email notifications (required to accept inquiries) ---
# API key from https://resend.com (API Keys → Create). Keep it secret.
RESEND_API_KEY=
# Where inquiries are delivered. Separate several addresses with commas.
INQUIRY_TO_EMAIL=
# Sender address on a domain you've verified in Resend, e.g. "Seagrape Website <inquiries@yourdomain.com>"
INQUIRY_FROM_EMAIL=

# Business name used in notification emails and texts (optional).
SITE_NAME=

# --- Optional SMS notifications (Twilio) ---
# Leave blank to turn SMS off. All four are needed to turn it on.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number in E.164 format, e.g. +19545550123
TWILIO_FROM_NUMBER=
# The owner's mobile number that should receive alerts, e.g. +19545550123
OWNER_SMS_NUMBER=
